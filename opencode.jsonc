{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "uv_python.md"
  ],
  "plugin": [
    [ "opencode-auto-resume", {
      "chunkTimeoutMs": 45000,
      "gracePeriosMs": 3000,
      "maxRetries": 3
    } ]
  ],
  "mcp": {
    "open-webui": {
      "enabled": true,
      "type": "remote",
      "url": "http://server.tailc63ae8.ts.net:4042/mcp"
    }
  },
  "disabled_providers": [],
  "provider": {
    "litellm": {
      "name": "litellm",
      "npm": "@ai-sdk/openai-compatible",
      "models": {        
        "qwen3.6:27b": {
          "name": "qwen3.6:27b",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "ornith-1.0:35b": {
          "name": "ornith-1.0:35b",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "input": 57344,
            "output": 8192
          }
        },
        "qwen3.6:27b-small": {
          "name": "qwen3.6:27b-small",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "input": 24576,
            "output": 8192
          }
        },
        "qwythos:9b": {
          "name": "qwythos:9b",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "input": 122880,
            "output": 8192
          }
        },
        "qwen3.6:35b-a3b": {
          "name": "qwen3.6:35b-a3b",
          "tool_call": true
        },
        "ornith1.0:9b": {
          "name": "ornith1.0:9b",
          "tool_call": true,
          "limit": {
            "context": 81920,
            "input": 81920,
            "output": 8192
          }
        },
        "gemma4:12b": {
          "name": "gemma4:12b",
          "tool_call": true
        }
      },
      "options": {
        "baseURL": "{env:LITELLM_SERVER}",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}

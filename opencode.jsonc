{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "litellm",
      "options": {
        "baseURL": "{env:LITELLM_SERVER}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "assistant": {
          "name": "assistant"
        },
        "big-pickle": {
          "name": "big-pickle"
        },
        "bonsai-27b-q1": {
          "name": "bonsai-27b-q1"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "desktop2.ornith1.5:35b-a3b": {
          "name": "desktop2.ornith1.5:35b-a3b"
        },
        "desktop2.ornith1.5:35b-a3b-small": {
          "name": "desktop2.ornith1.5:35b-a3b-small"
        },
        "embeddings": {
          "name": "embeddings"
        },
        "gemma4:12b": {
          "name": "gemma4:12b"
        },
        "gemma4:31b": {
          "name": "gemma4:31b"
        },
        "gemma4:31b-small": {
          "name": "gemma4:31b-small"
        },
        "gemma4:e4b": {
          "name": "gemma4:e4b"
        },
        "glm-5.1": {
          "name": "glm-5.1"
        },
        "glm-5.2": {
          "name": "glm-5.2"
        },
        "grug:27b": {
          "name": "grug:27b"
        },
        "homeassistant": {
          "name": "homeassistant"
        },
        "kat-coder": {
          "name": "kat-coder"
        },
        "lfm2.5-vl:3b": {
          "name": "lfm2.5-vl:3b"
        },
        "muse:30b": {
          "name": "muse:30b"
        },
        "muse:30b-small": {
          "name": "muse:30b-small"
        },
        "ornith-1.0:9b": {
          "name": "ornith-1.0:9b"
        },
        "ornith1.5:35b-a3b": {
          "name": "ornith1.5:35b-a3b"
        },
        "ornith1.5:35b-a3b-small": {
          "name": "ornith1.5:35b-a3b-small"
        },
        "ornith1.5:9b": {
          "name": "ornith1.5:9b"
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b"
        },
        "qwen3.5:9b-claude": {
          "name": "qwen3.5:9b-claude"
        },
        "qwen3.6:35b-a3b": {
          "name": "qwen3.6:35b-a3b"
        },
        "qwen3.8-27b:q4": {
          "name": "qwen3.8-27b:q4"
        },
        "qwen3.8-27b:q4_k_xl": {
          "name": "qwen3.8-27b:q4_k_xl"
        },
        "qwen3.8-27b:q6": {
          "name": "qwen3.8-27b:q6"
        },
        "qwen3.8-27b:q6-large": {
          "name": "qwen3.8-27b:q6-large"
        },
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        },
        "qwen3:14b": {
          "name": "qwen3:14b"
        },
        "qwythos:9b": {
          "name": "qwythos:9b"
        },
        "qwythos:9b-small": {
          "name": "qwythos:9b-small"
        },
        "reranker": {
          "name": "reranker"
        },
        "smol-pickle": {
          "name": "smol-pickle"
        },
        "summarizer": {
          "name": "summarizer"
        },
        "ternary-bonsai:27b": {
          "name": "ternary-bonsai:27b"
        },
        "tiel:35b-a3b": {
          "name": "tiel:35b-a3b"
        }
      }
    }
  },
  "disabled_providers": [],
  "instructions": [
    "uv_python.md"
  ],
  "plugin": [
    [
      "opencode-auto-resume",
      {
        "chunkTimeoutMs": 45000,
        "gracePeriosMs": 3000,
        "maxRetries": 3
      }
    ]
  ],
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
        "/home/sheigl/.local/bin/uvx",
        "blender-mcp"
      ],
      "enabled": true,
      "environment": {
        "DISABLE_TELEMETRY": "true"
      }
    },
    "open-webui": {
      "enabled": false,
      "type": "remote",
      "url": "http://server.tailc63ae8.ts.net:4042/mcp"
    }
  }
}

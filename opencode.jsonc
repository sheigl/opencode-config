      }
    ]
  ],
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "-e",
        "DISABLE_TELEMETRY=true",
        "blender",
        "/config/blender-mcp/venv/bin/python",
        "-m",
        "blender_mcp.server"
      ],
      "enabled": true
    },
    "open-webui": {
      "enabled": false,
      "type": "remote",
      "url": "http://server.tailc63ae8.ts.net:4042/mcp"
    },
    "browse-server": {
      "type": "remote",
      "url": "http://server.home:8111/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "{env:GITHUB_MCP_TOKEN}"
      },
      "enabled": true
    }
  }
